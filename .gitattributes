# The ASCII/ANSI art files are byte-sensitive: never let git rewrite newlines
# or try to "fix" the escape sequences.
config/logos/*.txt   -text

# Shell scripts must keep LF or bash will choke on the CR.
*.sh                 text eol=lf

# CMD refuses to parse a .bat that has LF-only line endings.
*.bat                text eol=crlf
*.ps1                text eol=crlf

assets/*.jpg         binary
